{
    "name": "atannex/intermidiate",
    "description": "Type-safe Presenters for Laravel: move data shaping, collection slicing, calendars, numbering, pagination and active states out of Blade and into small PHP classes, so views only hold markup.",
    "keywords": [
        "laravel",
        "presenter",
        "presenters",
        "model-presenter",
        "blade",
        "view-composer",
        "seo",
        "pagination",
        "calendar",
        "navigation",
        "active-state"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Atanga Leke Collins",
            "email": "atangageihlekecollins@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/pagination": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "nesbot/carbon": "^2.72|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Atannex\\Intermidiate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atannex\\Intermidiate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atannex\\Intermidiate\\IntermidiateServiceProvider"
            ],
            "aliases": {
                "Intermidiate": "Atannex\\Intermidiate\\Facades\\Intermidiate"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
