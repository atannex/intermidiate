{
    "name": "atannex/intermidiate",
    "description": "Display logic for Laravel, written once: model presenters give every view the same links, labels and dates for a model, and page Presenters prepare view data, so Blade only holds markup.",
    "keywords": [
        "laravel",
        "presenter",
        "presenters",
        "model-presenter",
        "view-model",
        "blade",
        "view-composer",
        "seo",
        "pagination",
        "calendar",
        "navigation",
        "active-state"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Atanga Leke Collins",
            "email": "atangageihlekecollins@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/pagination": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "nesbot/carbon": "^2.72|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "livewire/livewire": "^3.5",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Atannex\\Intermidiate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atannex\\Intermidiate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atannex\\Intermidiate\\IntermidiateServiceProvider"
            ],
            "aliases": {
                "Intermidiate": "Atannex\\Intermidiate\\Facades\\Intermidiate"
            }
        },
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
